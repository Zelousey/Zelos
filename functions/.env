# Non-secret settings for the Cloud Functions (secrets go in Secret Manager, never here).
# Square: "sandbox" while testing, "production" for real payments.
SQUARE_ENVIRONMENT=production
# Marketstack (stock prices). Basic plan: prices every 15 minutes, 15-minute bars.
# On the Professional plan set QUOTE_EVERY_MIN=1 and MS_INTERVAL=5min (or 1min).
QUOTE_EVERY_MIN=15
MS_INTERVAL=15min
