# Non-secret settings for the Cloud Functions (secrets go in Secret Manager, never here).
# Square: "sandbox" while testing, "production" for real payments.
SQUARE_ENVIRONMENT=production
# Marketstack (stock prices). Marketstack counts EVERY SYMBOL in a request as one call.
# Plan: 100,000 calls per billing cycle (the 7th to the 7th). See functions/mdata.py.
# Day-trading ("fast") stocks every QUOTE_EVERY_MIN minutes, the rest every MS_STEADY_EVERY_MIN:
# about 3,700 calls a market day + ~190 for the daily close = ~85,000 a cycle.
# Basic plan: QUOTE_EVERY_MIN=15 and MS_INTERVAL=15min.
QUOTE_EVERY_MIN=1
MS_STEADY_EVERY_MIN=15
MS_INTERVAL=1min
# Hard stops (the server refuses any call past them):
#   MS_LIVE_CAP   live prices stop until the next cycle
#   MS_HARD_CAP   everything stops (daily close, scanners) until the next cycle
#   MS_DAILY_CALLS live prices stop for the rest of the day
MS_CYCLE_DAY=7
MS_LIVE_CAP=95000
MS_HARD_CAP=98000
MS_DAILY_CALLS=4300
# Calls Marketstack had already counted this cycle before the per-symbol counter existed
# ("cycle:calls"; only used in that cycle). From the Marketstack dashboard.
MS_CYCLE_SEED=2026-10:114000
