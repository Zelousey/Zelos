# Non-secret settings for the Cloud Functions (secrets go in Secret Manager, never here).
# Square: "sandbox" while testing, "production" for real payments.
SQUARE_ENVIRONMENT=production
# Marketstack (stock prices). Professional plan or higher: prices every minute, 1-minute bars.
# A normal minute is ONE request for all 50 stocks (about 400 a market day, ~8,500 a month, plus
# ~40 after the close); MS_DAILY_CALLS / MS_MONTHLY_CALLS cap it, then updates slow to every 15 min.
# Set MS_MONTHLY_CALLS a little under the plan's monthly allowance (0 = no monthly cap).
# Basic plan: QUOTE_EVERY_MIN=15 and MS_INTERVAL=15min.
QUOTE_EVERY_MIN=1
MS_INTERVAL=1min
MS_DAILY_CALLS=1200
MS_MONTHLY_CALLS=0
