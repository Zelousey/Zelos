rules_version = '2';

// Zelos — Firestore security rules.
//
// How to install these: Firebase console → your project (leaderboard-agentictrading)
// → Build → Firestore Database → Rules tab → paste this whole file in → Publish.
//
// Design intent (matches the "never gate an alert" product rule):
//   - alerts are readable by ANYONE, no login required — a shared alert link must
//     always open straight to the full analysis.
//   - alerts are never writable from the browser. The scan pipeline writes them
//     server-side with a service-account key, which authenticates via Google's
//     Admin SDK / OAuth2 and bypasses these rules entirely — so "allow write: if false"
//     here is really "no client can write this," not "nothing can."
//   - everything about a specific person (profile, watchlist, xp, owned skills) is
//     readable and writable only by that signed-in person.
//   - the skills catalog (what's for sale) is public read, admin-only write.
//
// Known trade-off: XP/streaks are awarded client-side (zelos-xp.js), not by a
// server function, so a signed-in person could technically edit their own xp
// field via devtools if they really wanted to. There's no money or real
// account access riding on it, so this is an accepted limitation, not an
// oversight — revisit only if XP ever gates something that matters.

service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in email/Google account, never an anonymous guest session.
    function isRealAccount() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Alerts: the core "ALERT -> OPEN ZELOS -> SEE FULL ANALYSIS" record.
    // Public, read-only, no gating of any kind.
    match /alerts/{alertId} {
      allow read: if true;
      allow write: if false; // written only by the scan pipeline via the Admin SDK
    }

    // Globe market map (country moves, trending stocks, linked US-listed names).
    // Public read; written only by publish_market_map via the Admin SDK.
    match /markets/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Skills catalog: Swing Trader / Breakout Rider / Options Scanner listings.
    // Public read so the Arsenal page and Gumroad links work for signed-out visitors.
    match /skills/{skillId} {
      allow read: if true;
      allow write: if false; // maintained by hand / future admin tooling, not from the browser
    }

    // A user's own profile: owned skills, watchlist, xp, streaks, settings.
    // Only that person can read or write their own doc — never anyone else's.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // XP/streak event ledger — also doubles as the dedup record that stops the
      // same alert (or the same day's check-in/arcade play) from paying out twice.
      // Written by zelos-xp.js client-side, only ever to your own subcollection.
      match /activity/{activityId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Real Trade Journal (REAL mode): trades this person made at their own
      // broker, logged by them. Private: only the owner, from a real account.
      match /realTrades/{tradeId} {
        allow read, write: if isRealAccount() && request.auth.uid == userId;
      }
    }

    // "Vote for the next strategy" on the Upcoming Strategies section: one doc
    // per person, keyed by their own uid (real account OR the anonymous uid
    // zelos-xp.js silently signs every visitor in with — same trust model as
    // XP). Public read so the tallies/bars are visible to everyone, including
    // signed-out visitors; a person can only ever create/update/delete their
    // own single vote doc, so there's no way to inflate a strategy's count
    // beyond one vote per real Firebase user — the same accepted trade-off
    // already noted above for XP.
    match /strategyVotes/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Trade War public profiles: the $10,000 virtual account (PRACTICE mode),
    // for the Trade War leaderboards + practice/profile.html.
    // One doc per signed-in player, keyed by their uid, holding ONLY public
    // numbers: display name, balance, growth, resets, closed-trade stats. No
    // email or login details are ever written here. Anyone can read (the
    // leaderboard works signed out); only the owner can write or delete their
    // own doc, and only from a real (non-anonymous) account. A player who turns
    // their stats private deletes the doc. Same client-side trust trade-off as
    // XP above: it's virtual money, so a determined person could inflate their
    // own numbers via devtools.
    match /practiceProfiles/{userId} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if isRealAccount() && request.auth.uid == userId
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.equity is number;
    }

    // Public trader identity (profile page): display name, photo, and whatever
    // real-trading statistics the owner chose to show (never dollar amounts).
    match /traders/{userId} {
      allow read: if true;
      allow delete: if isRealAccount() && request.auth.uid == userId;
      allow create, update: if isRealAccount() && request.auth.uid == userId
        && request.resource.data.name is string && request.resource.data.name.size() <= 24;

      // One entry per logged real trade: ticker + a server timestamp that must
      // equal the write time, so entries can't be backdated or edited. The
      // "Real Trading: Active / Experience" status is computed from these.
      match /realLog/{logId} {
        allow read: if true;
        allow create: if isRealAccount() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['sym', 'createdAt'])
          && request.resource.data.sym is string && request.resource.data.sym.size() >= 1 && request.resource.data.sym.size() <= 10
          && request.resource.data.createdAt == request.time;
        allow delete: if isRealAccount() && request.auth.uid == userId;
        allow update: if false;
      }
    }

    // ---- Trade War social layer (zelos-social.js) ----
    // Virtual money only; same client-side trust trade-off as XP above.

    // Friend challenges. Public read so a shared link opens for anyone. Only a
    // real (non-anonymous) account can create one, as its own creator. The
    // creator may only cancel it. Anyone else (or only the invited target) may
    // accept an open challenge, and accepting can only fill in the acceptance
    // fields: opponent (themselves), names, start/end and the baselines.
    match /challenges/{challengeId} {
      allow read: if true;
      allow create: if isRealAccount()
        && request.resource.data.creator == request.auth.uid
        && request.resource.data.opponent == null
        && request.resource.data.status == 'open'
        && request.resource.data.days is number
        && request.resource.data.days >= 1 && request.resource.data.days <= 120;
      allow update: if isRealAccount() && (
        (resource.data.creator == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancelled')
        || (resource.data.status == 'open' && resource.data.opponent == null
          && request.auth.uid != resource.data.creator
          && (resource.data.target == null || resource.data.target == request.auth.uid)
          && request.resource.data.opponent == request.auth.uid
          && request.resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['opponent', 'opponentName', 'status', 'startAt', 'endAt', 'base']))
      );
      allow delete: if false;
    }

    // Trading Squads: private groups. Readable by any signed-in visitor who
    // has the (unguessable) invite id. The owner creates it with only
    // themselves as a member and can run competitions or rename it. Anyone
    // else can only add themselves (join) or remove themselves (leave).
    match /squads/{squadId} {
      // Joining or leaving may only add/remove your OWN entry in the names map,
      // never rename or remove another member.
      function onlyOwnName() {
        return request.resource.data.get('names', {}).diff(resource.data.get('names', {})).affectedKeys().hasOnly([request.auth.uid]);
      }
      allow read: if request.auth != null;
      allow create: if isRealAccount()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 32;
      allow update: if isRealAccount() && (
        (resource.data.owner == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comp', 'name']))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
          && onlyOwnName()
          && request.resource.data.names[request.auth.uid] is string
          && request.resource.data.names[request.auth.uid].size() <= 24
          && !(request.auth.uid in resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.size() <= 50)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
          && onlyOwnName()
          && request.auth.uid in resource.data.members
          && request.auth.uid != resource.data.owner
          && !(request.auth.uid in request.resource.data.members)
          && resource.data.members.hasAll(request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1)
      );
      allow delete: if isRealAccount() && resource.data.owner == request.auth.uid;
    }

    // Referrals: one doc per invited player, keyed by THEIR uid and written
    // once by them (never edited), naming who invited them. Readable only by
    // that player and by the referrer (who counts their successes).
    match /referrals/{userId} {
      allow create: if isRealAccount() && request.auth.uid == userId
        && request.resource.data.referrer is string
        && request.resource.data.referrer != userId
        && request.resource.data.keys().hasOnly(['referrer', 'createdAt']);
      allow read: if request.auth != null
        && (request.auth.uid == userId || resource.data.referrer == request.auth.uid);
      allow update, delete: if false;
    }

    // Unclaimed Gumroad purchases, keyed by the lowercased email used at checkout.
    // Written only by the gumroad_ping Cloud Function (Admin SDK, bypasses these
    // rules). A signed-in person may read and delete only the doc matching their
    // own login email - that's how they "claim" it into their own users/ doc on
    // next sign-in (see claimPendingOwnership() in dashboard.html / my-zelos.html).
    // Never client-writable: the webhook is the only thing allowed to create one.
    match /pendingOwnership/{email} {
      allow read, delete: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == email;
      allow write: if false;
    }
  }
}
