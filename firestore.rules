rules_version = '2';

// Zelos — Firestore security rules.
//
// How to install these: Firebase console → your project (leaderboard-agentictrading)
// → Build → Firestore Database → Rules tab → paste this whole file in → Publish.
//
// Design intent (matches the "never gate an alert" product rule):
//   - alerts are readable by ANYONE, no login required — a shared alert link must
//     always open straight to the full analysis.
//   - alerts are never writable from the browser. The scan pipeline writes them
//     server-side with a service-account key, which authenticates via Google's
//     Admin SDK / OAuth2 and bypasses these rules entirely — so "allow write: if false"
//     here is really "no client can write this," not "nothing can."
//   - everything about a specific person (profile, watchlist, xp, owned skills) is
//     readable and writable only by that signed-in person.
//   - the skills catalog (what's for sale) is public read, admin-only write.
//
// XP: awarded only by the xp_award Cloud Function (amounts and daily limits in
// functions/xp.py). The browser can't write users/{uid}.xp, streakDays,
// lastAlertOpenDate or the activity ledger, because Trade War buy-in tiers,
// the whale role and community limits read XP on the server.

service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in email/Google account, never an anonymous guest session.
    function isRealAccount() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Profile picture: a Google account photo (https) or a small image the
    // person uploaded, resized in the browser to a data URL (max ~20 KB).
    function validPhoto(v) {
      return v == null || (v is string && (
        (v.size() <= 2048 && v.matches('^https://[^"<>\\s]+$'))
        || (v.size() <= 20000 && v.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$'))));
    }

    // Usernames: 3-20 lowercase letters, digits or underscores.
    function validUsername(v) {
      return v is string && v.matches('^[a-z0-9_]{3,20}$');
    }

    // Alerts: the core "ALERT -> OPEN ZELOS -> SEE FULL ANALYSIS" record.
    // Public, read-only. Alerts with a trade are a teaser here until the trade
    // finishes (the full alert is in alertsLocked, token-gated).
    match /alerts/{alertId} {
      allow read: if true;
      allow write: if false; // written only by the scan pipeline via the Admin SDK
    }

    // Tokens (functions/main.py, Tokens section). Every balance change happens in a
    // Cloud Function transaction that also writes the ledger line; browsers can
    // only read their own wallet and history.
    match /wallets/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
      match /ledger/{entryId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }
    // Payments (Square): purchase records, the checkouts we created and the webhook
    // events already handled. Server only.
    match /purchases/{purchaseId} {
      allow read, write: if false;
    }
    match /squareCheckouts/{orderId} {
      allow read, write: if false;
    }
    match /squareEvents/{eventId} {
      allow read, write: if false;
    }
    // Zelos News posts (app News tab). Anyone can read; only the news_save / news_delete
    // functions write them, after checking admins/{uid}.
    match /news/{postId} {
      allow read: if true;
      allow write: if false;
    }
    // Site owner accounts (sales.html). Added by hand in the Firebase console; server only.
    match /admins/{uid} {
      allow read, write: if false;
    }
    // The full alert while it's token-gated (the public alerts/{id} doc is a teaser
    // until its trade finishes; live price before the close, cheaper after).
    // Readable with an active pass for that scanner or a single unlock of this alert.
    match /alertsLocked/{alertId} {
      function wallet() { return get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data; }
      allow get: if request.auth != null
        && exists(/databases/$(database)/documents/wallets/$(request.auth.uid))
        && (wallet().get('passes', {}).get(resource.data.strategy, 0) > request.time.toMillis()
          || alertId in wallet().get('unlocked', []));
      allow list, write: if false;
    }

    // Public Trade War record per player (played / wins / losses / surrenders, recent
    // matches). Written only by the server when a match ends (tw_record_results).
    match /twRecords/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // Globe market map (country moves, trending stocks, linked US-listed names).
    // Public read; written only by publish_market_map via the Admin SDK.
    match /markets/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Skills catalog: Swing Trader / Breakout Rider / Options Scanner listings.
    // Public read so the Arsenal page works for signed-out visitors.
    match /skills/{skillId} {
      allow read: if true;
      allow write: if false; // maintained by hand / future admin tooling, not from the browser
    }

    // A user's own profile: owned skills, watchlist, xp, streaks, settings.
    // Only that person can read or write their own doc — never anyone else's.
    match /users/{userId} {
      // missions: counted by the server (functions/missions.py), so mission XP can't be faked
      function serverFields() { return ['xp', 'streakDays', 'lastAlertOpenDate', 'missions']; }
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      // a new doc may only start XP and the streak at zero
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('xp', 0) == 0
        && request.resource.data.get('streakDays', 0) == 0
        && !('lastAlertOpenDate' in request.resource.data)
        && !('missions' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverFields());

      // XP/streak event ledger — also doubles as the dedup record that stops the
      // same alert (or the same day's check-in/arcade play) from paying out twice.
      // Written only by the xp_award function; you can read your own.
      match /activity/{activityId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // xp_award writes it
      }

      // The bell: notifications about you (challenges, battles, friends, community,
      // fills), written by the server. You can read them, mark them read, or delete them.
      match /inbox/{noteId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read is bool;
        allow create: if false;
      }

      // Real Trade Journal (REAL mode): trades this person made at their own
      // broker, logged by them. Private: only the owner, from a real account.
      match /realTrades/{tradeId} {
        allow read, write: if isRealAccount() && request.auth.uid == userId;
      }
    }

    // "Vote for the next strategy" on the Upcoming Strategies section: one doc
    // per person, keyed by their own uid (real account OR the anonymous uid
    // zelos-xp.js silently signs every visitor in with — same trust model as
    // XP). Public read so the tallies/bars are visible to everyone, including
    // signed-out visitors; a person can only ever create/update/delete their
    // own single vote doc, so there's no way to inflate a strategy's count
    // beyond one vote per real Firebase user — the same accepted trade-off
    // already noted above for XP.
    match /strategyVotes/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Public practice profiles (leaderboards, practice/profile.html). Since 2026-10-07 the
    // numbers are computed and written by the server (practice_* functions) from the server
    // practice account, so they can't be inflated from a browser. The owner may still update
    // their display identity (zelos-profile.js keeps name/username/photo in sync) and the
    // cosmetic achievements/streak, or delete the doc (hide their stats).
    match /practiceProfiles/{userId} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create: if false;
      allow update: if isRealAccount() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'username', 'photo', 'achievements', 'streak'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && validPhoto(request.resource.data.get('photo', null))
        && (request.resource.data.get('username', null) == null || validUsername(request.resource.data.username))
        && (request.resource.data.get('achievements', []) is list && request.resource.data.get('achievements', []).size() <= 80)
        && (request.resource.data.get('streak', 0) is int && request.resource.data.get('streak', 0) >= 0 && request.resource.data.get('streak', 0) <= 3650);
    }

    // The practice account itself and its history: owner reads, only the server writes
    // (orders, fills and balances are decided by Cloud Functions on server prices).
    match /practiceAccounts/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
      match /history/{eventId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // The old browser-written account, archived read-only when the server account opened.
    match /practiceArchive/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Username reservations: one doc per taken username, naming its owner, so
    // two people can never hold the same @name. Created in the same batch that
    // sets traders/{uid}.username, and released in the batch that changes it.
    match /usernames/{name} {
      allow read: if true;
      allow create: if isRealAccount() && validUsername(name)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/traders/$(request.auth.uid)).data.get('username', null) == name;
      allow delete: if isRealAccount() && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/traders/$(request.auth.uid)).data.get('username', null) != name;
      allow update: if false;
    }

    // Public trader identity (profile page): display name, photo, and whatever
    // real-trading statistics the owner chose to show (never dollar amounts).
    match /traders/{userId} {
      allow read: if true;
      allow delete: if isRealAccount() && request.auth.uid == userId;
      allow create, update: if isRealAccount() && request.auth.uid == userId
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && validTraderProfile(userId);

      // username must be reserved by this person in the same write; changing it
      // must release the old reservation; bio max 160 chars; photos validated.
      function validTraderProfile(userId) {
        let d = request.resource.data;
        let uname = d.get('username', null);
        let before = resource == null ? null : resource.data.get('username', null);
        return (uname == null || (validUsername(uname)
              && getAfter(/databases/$(database)/documents/usernames/$(uname)).data.uid == userId))
          && (before == null || before == uname
              || !existsAfter(/databases/$(database)/documents/usernames/$(before)))
          && (d.get('bio', null) == null || (d.bio is string && d.bio.size() <= 160))
          && validPhoto(d.get('avatar', null)) && validPhoto(d.get('photo', null));
      }

      // One entry per logged real trade: ticker + a server timestamp that must
      // equal the write time, so entries can't be backdated or edited. The
      // "Real Trading: Active / Experience" status is computed from these.
      match /realLog/{logId} {
        allow read: if true;
        allow create: if isRealAccount() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['sym', 'createdAt'])
          && request.resource.data.sym is string && request.resource.data.sym.size() >= 1 && request.resource.data.sym.size() <= 10
          && request.resource.data.createdAt == request.time;
        allow delete: if isRealAccount() && request.auth.uid == userId;
        allow update: if false;
      }
    }

    // ---- Trade War social layer (zelos-social.js) ----
    // Virtual money only; same client-side trust trade-off as XP above.

    match /challenges/{challengeId} {
      // Retired: friend challenges are Trade War matches now (tradeWars / twInvites).
      // Old docs stay readable; nothing new can be created or changed.
      allow read: if true;
      allow write: if false;
    }

    // Trade War matches (functions/main.py tw_*): equal buy-in, server-run.
    // Browsers can never write any of it: joining, trading and results all go
    // through Cloud Functions that enforce the rules of the game. The match doc
    // is readable by any signed-in visitor holding the (unguessable) invite id;
    // the leaderboard numbers only by players in that match; a player's
    // positions and fills only by that player (or by all players in a squad
    // match whose owner turned on "view everyone's trades").
    match /tradeWars/{warId} {
      allow read: if request.auth != null;
      allow write: if false;
      match /accounts/{uid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/tradeWars/$(warId)).data.players;
        allow write: if false;
      }
      // Battlefield Ticker: server-written match events, readable by the players.
      match /events/{eventId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/tradeWars/$(warId)).data.players;
        allow write: if false;
      }
      match /books/{uid} {
        // your own always; everyone's when the match allows it (squad setting "view everyone's trades")
        allow read: if request.auth != null && (request.auth.uid == uid
          || (get(/databases/$(database)/documents/tradeWars/$(warId)).data.get('rules', {}).get('viewTrades', false) == true
            && request.auth.uid in get(/databases/$(database)/documents/tradeWars/$(warId)).data.players));
        allow write: if false;
      }
    }

    // Trade War challenge invites (tw_challenge / tw_respond). Only the two
    // people involved can see an invite; only the server can create or answer one.
    match /twInvites/{inviteId} {
      allow read: if request.auth != null
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow write: if false;
    }

    // Trading Squads: private groups. A squad can be opened by any signed-in
    // visitor holding its (unguessable) invite id or a room code; listing is
    // limited to squads you're in. The owner creates it with only themselves
    // as a member and controls the settings, goal, competitions and room code,
    // and can remove members. Anyone else can only add themselves (join) or
    // remove themselves (leave).
    match /squads/{squadId} {
      // Joining or leaving may only add/remove your OWN entry in the names map,
      // never rename or remove another member.
      function onlyOwnName() {
        return request.resource.data.get('names', {}).diff(resource.data.get('names', {})).affectedKeys().hasOnly([request.auth.uid]);
      }
      function validConfig(c) {
        return c is map && c.keys().hasOnly(['reactions', 'photos', 'viewTrades', 'symbols'])
          && c.get('reactions', true) is bool && c.get('photos', false) is bool && c.get('viewTrades', false) is bool
          && (c.get('symbols', null) == null || (c.symbols is list && c.symbols.size() <= 60));
      }
      function validGoal(g) {
        return g == null || (g is map && g.keys().hasOnly(['text', 'target', 'days', 'start', 'end', 'base'])
          && g.text is string && g.text.size() <= 80 && g.target is number && g.target > 0 && g.target <= 100
          && g.days in [7, 30] && g.end == g.start + g.days * 86400000);
      }
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if isRealAccount()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 32;
      allow update: if isRealAccount() && (
        (resource.data.owner == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comp', 'name', 'helpMode', 'config', 'goal', 'code', 'members', 'names'])
          && request.resource.data.get('helpMode', false) is bool
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 32
          && validConfig(request.resource.data.get('config', {}))
          && validGoal(request.resource.data.get('goal', null))
          && (request.resource.data.get('code', null) == null || request.resource.data.code.matches('^[A-HJ-NP-Z2-9]{6}$'))
          // the owner can remove members (never add anyone, never remove themselves)
          && resource.data.members.hasAll(request.resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.get('names', {}).keys().hasOnly(request.resource.data.members)
          && request.resource.data.get('names', {}).diff(resource.data.get('names', {})).addedKeys().size() == 0
          && request.resource.data.get('names', {}).diff(resource.data.get('names', {})).changedKeys().size() == 0)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
          && onlyOwnName()
          && request.resource.data.names[request.auth.uid] is string
          && request.resource.data.names[request.auth.uid].size() <= 24
          && !(request.auth.uid in resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.size() <= 50)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
          && onlyOwnName()
          && request.auth.uid in resource.data.members
          && request.auth.uid != resource.data.owner
          && !(request.auth.uid in request.resource.data.members)
          && resource.data.members.hasAll(request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1)
      );
      allow delete: if isRealAccount() && resource.data.owner == request.auth.uid;

      // Squad chat: members only. You post as yourself; nobody can edit a
      // message. Reactions: each member sets or clears only their own one
      // (r.<uid>), and only while the owner allows reactions. Photos only when
      // the owner allows them, as a small JPEG resized in the browser.
      match /messages/{msgId} {
        function squad() { return get(/databases/$(database)/documents/squads/$(squadId)).data; }
        function isMember() { return request.auth != null && request.auth.uid in squad().members; }
        allow read: if isMember();
        allow create: if isRealAccount() && isMember()
          && request.resource.data.keys().hasOnly(['author', 'name', 'text', 'photo', 'createdAt', 'r'])
          && request.resource.data.author == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 24
          && request.resource.data.text is string && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time
          && request.resource.data.get('r', {}).size() == 0
          && (request.resource.data.get('photo', null) == null
            || (squad().get('config', {}).get('photos', false) == true
              && request.resource.data.photo is string && request.resource.data.photo.size() <= 250000
              && request.resource.data.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')))
          && (request.resource.data.text.size() > 0 || request.resource.data.get('photo', null) != null);
        allow update: if isRealAccount() && isMember()
          && squad().get('config', {}).get('reactions', true) == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['r'])
          && request.resource.data.get('r', {}).diff(resource.data.get('r', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.get('r', {}))
            || request.resource.data.r[request.auth.uid] in ['like', 'fire', 'rocket', 'trophy', 'smile']);
        allow delete: if request.auth != null
          && (resource.data.author == request.auth.uid || squad().owner == request.auth.uid);
      }
    }

    // Private room codes: 6 characters that open a squad (squadCodes/{CODE} =
    // { squad }). Look-up by exact code only, no listing. Only that squad's
    // owner can create or remove its code.
    match /squadCodes/{code} {
      allow get: if request.auth != null;
      allow list, update: if false;
      allow create: if isRealAccount() && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['squad'])
        && get(/databases/$(database)/documents/squads/$(request.resource.data.squad)).data.owner == request.auth.uid;
      allow delete: if isRealAccount()
        && get(/databases/$(database)/documents/squads/$(resource.data.squad)).data.owner == request.auth.uid;
    }

    // Referrals: one doc per invited player, keyed by THEIR uid and written
    // once by them (never edited), naming who invited them. Readable only by
    // that player and by the referrer (who counts their successes).
    // Invites (functions/main.py invite_*): Battle, Team up, Invite a friend. Server-written.
    // Anyone may read one by its code (the link preview shows who invited you before you sign
    // in; it holds public names only); you can list the invites you made.
    match /invites/{code} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.from == request.auth.uid;
      allow write: if false;
      match /{sub=**} {
        allow read, write: if false;
      }
    }
    // Coach / Learn (functions/main.py coach_*): only the coach and the student can read their
    // coaching, its tasks and notes; the server writes everything. coaches/{uid} = public badge.
    match /coachings/{cid} {
      // written as two checks so a query on either field ("my coaching", "my students") is allowed
      allow read: if request.auth != null && (request.auth.uid == resource.data.coach || request.auth.uid == resource.data.student);
      allow write: if false;
      match /{sub}/{id} {
        allow read: if request.auth != null && request.auth.uid in [get(/databases/$(database)/documents/coachings/$(cid)).data.coach, get(/databases/$(database)/documents/coachings/$(cid)).data.student];
        allow write: if false;
      }
    }
    match /coaches/{userId} {
      allow read: if true;
      allow write: if false;
    }
    match /inviteState/{userId} {
      allow read, write: if false;
    }

    // Written only by the server (invite_accept / referral_claim, owner decision 2026-10-08):
    // it checks the account is new and pays the referral XP, so referrals can't be faked.
    match /referrals/{userId} {
      allow create: if false;
      allow read: if request.auth != null
        && (request.auth.uid == userId || resource.data.referrer == request.auth.uid);
      allow update, delete: if false;
    }

    // Profile cosmetics you show (name color, badge, banner, Founder title).
    // Public so anyone can see them; only Cloud Functions write (you buy and equip
    // through cosmetics_buy / cosmetics_equip, which check you own it).
    match /cosmetics/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // Founder Program communities (functions/main.py community_*). Public pages,
    // member lists and leaderboards; every change goes through Cloud Functions,
    // which enforce one community per person and count only real members.
    match /communities/{cid} {
      allow read: if true;
      allow write: if false;
      match /members/{uid} {
        allow read: if true;
        allow write: if false;
      }
    }
    // Your membership (active days, whether you've counted for a founder): you only.
    match /communityMembers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Hashed network ids used to stop duplicate accounts counting. Server only.
    match /communityPrivate/{cid} {
      allow read, write: if false;
    }

    // Push notifications: device tokens and the "already notified" record per alert.
    // Server only (push_register / push_unregister / publish_alert).
    match /pushTokens/{id} {
      allow read, write: if false;
    }
    match /alertPushes/{alertId} {
      allow read, write: if false;
    }

    // Retired with Gumroad: old purchase claims. Nothing reads or writes them now.
    // XP daily limits (xp_award). Server only.
    match /xpState/{uid} {
      allow read, write: if false;
    }

    match /pendingOwnership/{email} {
      allow read, write: if false;
    }
  }
}
