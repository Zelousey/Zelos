{
  "rules": {
    "scores": {
      "$game": {
        ".read": "$game === 'bull-run' || $game === 'buy-the-dip' || $game === 'setup-spotter' || $game === 'chart-replay' || $game === 'grade-the-setup' || $game === 'stop-drill' || $game.matches(/^daily-[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
        ".indexOn": ["score"],
        "$entry": {
          ".write": "auth != null && !data.exists() && ($game === 'bull-run' || $game === 'buy-the-dip' || $game === 'setup-spotter' || $game === 'chart-replay' || $game === 'grade-the-setup' || $game === 'stop-drill' || $game.matches(/^daily-[0-9]{4}-[0-9]{2}-[0-9]{2}$/)) && newData.parent().parent().parent().child('lastPost').child(auth.uid).val() === now && (!data.parent().parent().parent().child('lastPost').child(auth.uid).exists() || data.parent().parent().parent().child('lastPost').child(auth.uid).val() < now - 10000)",
          ".validate": "newData.hasChildren(['name', 'score', 'ts', 'uid'])",
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
          "score": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100000 && ($game.matches(/^daily-/) ? newData.val() <= 500 : true)" },
          "ts": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
          "uid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "ref": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 64" },
          "$other": { ".validate": false }
        }
      }
    },
    "lastPost": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === now"
      }
    }
  }
}
